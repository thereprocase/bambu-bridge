# Server
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8080
BRIDGE_API_KEY=             # generate with `openssl rand -hex 32`

# Storage
BRIDGE_DB_PATH=/var/lib/bambu-bridge/jobs.db
BRIDGE_FILES_DIR=/var/lib/bambu-bridge/files

# Logging
BRIDGE_LOG_LEVEL=info
BRIDGE_LOG_FORMAT=json

# Push (optional)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
