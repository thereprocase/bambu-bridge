# Bambu Bridge runtime env — systemd EnvironmentFile format.
#
# Copy to ~/.config/bambu-bridge/bridge.env, fill BRIDGE_API_KEY, chmod 600.
# systemd EnvironmentFile is NOT a shell file: no inline `#` comments after
# values, no quoting, no expansion. Keep one KEY=value per line.
#
# pydantic-settings reads these as real env vars (field == var lowercased),
# so this fully replaces the dev-time .env. Printers are NOT configured here
# — add them at runtime via POST /api/v1/printers (no restart).
#
# The systemd unit already sets BRIDGE_DB_PATH + BRIDGE_FILES_DIR via the
# `%h` user-home specifier (`Environment=` in bambu-bridge.service), so this
# file only needs BRIDGE_API_KEY in practice. The path lines below are
# commented out — uncomment to OVERRIDE the unit defaults.

# Generate: openssl rand -hex 32
BRIDGE_API_KEY=

BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8080

# Optional read-only token for sharing print-viewer links without handing out
# the master key. When set, it grants read-only access to the viewer page,
# the 3MF mesh, and the state snapshot (and nothing else — no control, no
# files, no WebSocket). Used for the Home Assistant dashboard iframe and for
# opening /viz?token=... in a phone browser over Tailscale.
# Generate: openssl rand -hex 32
# Leave blank to require the master key (BRIDGE_API_KEY) for the viewer too.
BRIDGE_VIZ_TOKEN=

# Storage overrides (defaults are %h/.local/share/bambu-bridge/* via the unit;
# uncomment + edit to relocate the DB or upload area).
# BRIDGE_DB_PATH=/var/lib/bambu-bridge/jobs.db
# BRIDGE_FILES_DIR=/var/lib/bambu-bridge/files

# Optional override for backup.sh (defaults to $BRIDGE_DB_PATH dir + /backups).
# BACKUP_DIR=/var/lib/bambu-bridge/backups
# BACKUP_KEEP=14

BRIDGE_LOG_LEVEL=info
BRIDGE_LOG_FORMAT=json

# Phase 1 spaghetti detection. Default off until validated on real chamber
# frames. Set true to arm the debounced vision abort path; it never weakens
# the telemetry air watchdog.
BRIDGE_SPAGHETTI_DETECTION=false

# Optional push notifications.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
